FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY sla_core/ sla_core/
COPY demo_v3/ demo_v3/
EXPOSE 8502
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8502/_stcore/health')" || exit 1
CMD ["streamlit", "run", "demo_v3/app.py", "--server.port=8502", "--server.address=0.0.0.0", "--server.headless=true"]
